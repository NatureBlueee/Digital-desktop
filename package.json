    "typecheck": "tsc --noEmit",
    "test": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' node --require ts-node/register --test src/lib/notion/database-summary.test.ts",
    "test:release": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "code-server": "code-server --bind-addr 127.0.0.1:3001 --auth none .",
