# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Key (for upload scripts - DO NOT expose to frontend!)
# Get this from: Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Notion Configuration
# Get from: https://www.notion.so/my-integrations
# Create an integration and copy the "Internal Integration Token"

# For multi-page Notion app (NotionAppImproved - displays all accessible pages)
NOTION_API_KEY=secret_your_notion_integration_token_here

# For single-page showcase (optional - used by legacy NotionApp)
NOTION_TOKEN=your_notion_integration_token_here
NOTION_ROOT_PAGE_ID=your_notion_page_id_here

# After creating the integration:
# 1. Go to your Notion pages
# 2. Click "..." menu > Add connections > Select your integration
# 3. All connected pages will appear in the Notion app

# GitHub OAuth Configuration (for Fork + PR contribution system)
# Get from: https://github.com/settings/developers
# Create a new OAuth App and copy the Client ID and Client Secret
GITHUB_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here

# Repository information (defaults to NatureBlueee/Digital-desktop if not set)
GITHUB_REPO_OWNER=NatureBlueee
GITHUB_REPO_NAME=Digital-desktop

# Base URL for OAuth callbacks (required for production)
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# code-server URL (for Theia/Cursor IDE integration)
# Development: http://localhost:3001
# Production: http://165.22.62.244:3001 (or your VPS IP)
NEXT_PUBLIC_CODE_SERVER_URL=http://165.22.62.244:3001
